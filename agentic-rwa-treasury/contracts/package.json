{
  "name": "@agentic-rwa/contracts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "node": "hardhat node",
    "build": "hardhat build --build-profile production",
    "compile": "hardhat build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "hardhat test nodejs",
    "test:solidity": "hardhat test solidity",
    "deploy:local": "hardhat run script/deploy.ts --network localhost",
    "deploy:testnet": "hardhat run script/deploy.ts --network xlayerTestnet",
    "demo:rejection": "hardhat run script/demo-rejection.ts --network xlayerTestnet",
    "clean": "hardhat clean"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "dotenv": "17.4.2"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-viem": "5.0.7",
    "@types/node": "22.15.30",
    "hardhat": "3.13.0",
    "typescript": "7.0.2",
    "viem": "2.55.8"
  }
}
