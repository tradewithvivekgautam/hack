NODE_ENV=development
LOG_LEVEL=info
AGENT_PROVIDER=fixture
AGENT_MODEL=deepseek-v4-pro
AGENT_TEMPERATURE=0.1

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/beta
MODAL_API_KEY=
MODAL_BASE_URL=
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

CHAIN_MODE=fixture
# Use 31337 + http://127.0.0.1:8545 for the persistent local Hardhat node.
XLAYER_CHAIN_ID=1952
XLAYER_RPC_URL=https://testrpc.xlayer.tech/terigon
AGENT_PRIVATE_KEY=
VAULT_ADDRESS=
POLICY_ADDRESS=
REGISTRY_ADDRESS=
RWA_ADAPTER_ADDRESS=
LENDING_ADAPTER_ADDRESS=
IDLE_ADAPTER_ADDRESS=

IPFS_PROVIDER=local
IPFS_LOCAL_DIRECTORY=.data/ipfs
PINATA_JWT=
CORPUS_MANIFEST=corpus/sources.json
SOURCE_CACHE_DIRECTORY=.data/source-cache
DIAGNOSTICS_PROVIDER=sqlite
DIAGNOSTICS_SQLITE_PATH=.data/agent.sqlite
AGENT_CRON=0 * * * *
AGENT_RUN_ON_START=true

OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
OKX_RWA_TOKEN_ADDRESS=
OKX_QUOTE_TOKEN_ADDRESS=
OKX_QUOTE_AMOUNT=100000000000000000000000
OKX_QUOTE_NOTIONAL_USD=100000
